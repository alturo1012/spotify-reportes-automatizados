# Credenciales de tu app de Spotify (Spotify for Developers -> Dashboard),
# necesarias para resolver la columna "Fecha de Lanzamiento" del listado de
# canciones de "Resumen Total" (ver src/spotify_release_dates.py).
#
# Copiá este archivo a ".env" (ese sí está en .gitignore, nunca se sube a
# GitHub) y poné ahí tus valores reales:
#
#   cp .env.example .env
#
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
